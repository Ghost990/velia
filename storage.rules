rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow read access to everyone
      allow read: if true;
      
      // Allow write access to everyone during development
      // In production, you should restrict this to authenticated users
      allow write: if true;
      
      // For production, use this rule instead:
      // allow write: if request.auth != null;
    }
  }
}
